{
  "manifest_version": 3,
  "name": "Pockett Connector",
  "description": "Capture securely credentials from web apps (Klarna today — more providers later) and send them to your Pockett instance.",
  "version": "0.1.4",
  "key": "",
  "action": {
    "default_title": "Pockett Connector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "scripting", "alarms", "webRequest", "webNavigation"],
  "host_permissions": [
    "https://app.klarna.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "*://localhost/*",
      "*://127.0.0.1/*",
      "*://192.168.1.7/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://app.klarna.com/*"],
      "js": ["providers/klarna.js", "content/capture.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/pockett-app.js"],
      "run_at": "document_idle"
    }
  ]
}
